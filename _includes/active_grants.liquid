<ol>
{% assign today = site.time | date: '%s' %}
{% assign n = 0 %}
{% for grant in site.data.grants %}{% assign is_active = false %}{% if grant.end_date %}{% assign end_ts = grant.end_date | date: '%s' %}{% if end_ts >= today %}{% assign is_active = true %}{% endif %}{% endif %}{% if is_active %}{% assign n = n | plus: 1 %}<li>{{ grant.role }}. &ldquo;{% if grant.award_url %}<a href="{{ grant.award_url }}" rel="external nofollow noopener" target="_blank">{{ grant.title }}</a>{% else %}{{ grant.title }}{% endif %}.&rdquo; <a href="{{ grant.agency_url }}" rel="external nofollow noopener" target="_blank">{{ grant.agency }}</a>{% if grant.note %} ({{ grant.note }}){% endif %}. {{ grant.amount }}{% if grant.dates %}. {{ grant.dates }}{% endif %}.</li>
{% endif %}{% endfor %}
</ol>
